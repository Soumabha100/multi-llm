rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {
      // Read: only if authenticated and resource uid matches auth uid
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Create: only if authenticated and the incoming document uid matches auth uid
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      
      // Update/Delete: only if authenticated and the existing document uid matches auth uid
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      match /messages/{messageId} {
        // Read/Write messages only if the parent session document exists and belongs to the user
        allow read, write: if isAuthenticated() && 
                           get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid == request.auth.uid;
      }
    }

    // Deny-by-default: Explicitly block any path not covered above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
