# API Keys for LLM providers
# Leave blank or empty to use intelligent simulation/demo mode for development & testing
TOKENHARBOR_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Application Settings
APP_NAME="Multi-LLM Custom ChatGPT"
APP_ENV=development
DEBUG=True
DEMO_MODE=True

# Default LLM Models
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_MODEL=gemini-1.5-flash

# CORS Settings (comma-separated list of allowed origins or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,*

# Server host & port
HOST=0.0.0.0
PORT=8000
TOKENHARBOR_BASE_URL=https://api.tokenharbor.com/v1
